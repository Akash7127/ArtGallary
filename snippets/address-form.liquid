{% doc %}
  Address fields for adding or editing a customer address.
  Must be rendered inside a 'customer_address' form.

  @param {object} form - The customer_address form
  @param {string} id - A unique suffix for field ids (e.g. 'New' or the address id)

  @example
  {% render 'address-form', form: form, id: 'New' %}
{% enddoc %}

{% if form.errors %}
  <div class="ag-form-errors" role="alert">{{ form.errors | default_errors }}</div>
{% endif %}

<div class="ag-form-row">
  <div class="ag-field">
    <label for="AddressFirstName{{ id }}">{{ 'customers.register.first_name' | t }}</label>
    <input type="text" id="AddressFirstName{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="ag-field">
    <label for="AddressLastName{{ id }}">{{ 'customers.register.last_name' | t }}</label>
    <input type="text" id="AddressLastName{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="ag-field">
  <label for="AddressCompany{{ id }}">{{ 'customers.addresses.company' | t }}</label>
  <input type="text" id="AddressCompany{{ id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="ag-field">
  <label for="AddressAddress1{{ id }}">{{ 'customers.addresses.address1' | t }}</label>
  <input type="text" id="AddressAddress1{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="ag-field">
  <label for="AddressAddress2{{ id }}">{{ 'customers.addresses.address2' | t }}</label>
  <input type="text" id="AddressAddress2{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="ag-form-row">
  <div class="ag-field">
    <label for="AddressCity{{ id }}">{{ 'customers.addresses.city' | t }}</label>
    <input type="text" id="AddressCity{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="ag-field">
    <label for="AddressZip{{ id }}">{{ 'customers.addresses.zip' | t }}</label>
    <input type="text" id="AddressZip{{ id }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code">
  </div>
</div>
<div class="ag-form-row">
  <div class="ag-field">
    <label for="AddressCountry{{ id }}">{{ 'customers.addresses.country' | t }}</label>
    <select
      id="AddressCountry{{ id }}"
      name="address[country]"
      data-default="{{ form.country }}"
      data-address-country="{{ id }}"
      autocomplete="country"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="ag-field" id="AddressProvinceContainer{{ id }}">
    <label for="AddressProvince{{ id }}">{{ 'customers.addresses.province' | t }}</label>
    <select
      id="AddressProvince{{ id }}"
      name="address[province]"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
    ></select>
  </div>
</div>
<div class="ag-field">
  <label for="AddressPhone{{ id }}">{{ 'customers.addresses.phone' | t }}</label>
  <input type="tel" id="AddressPhone{{ id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="ag-auth__check">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customers.addresses.set_default' | t }}</span>
</label>
