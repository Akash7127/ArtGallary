{% doc %}
  Toolbar for a filtered list (collection or search): filter button for
  phones, result count, sort menu, and chips for each active filter.
  Must be rendered inside the filter form.

  @param {object} results - The collection or search object
  @param {number} count - Number of results to show
  @param {boolean} show_filters - Whether filters are shown
  @param {boolean} enable_sorting - Whether to show the sort menu
  @param {number} active_count - Number of active filters
  @param {string} sort_by - Current sort value
  @param {string} clear_url - URL that removes all filters

  @example
  {% render 'facets-toolbar', results: collection, count: collection.products_count, show_filters: true, enable_sorting: true, active_count: 0, sort_by: sort_by, clear_url: clear_url %}
{% enddoc %}

<div class="ag-coll__toolbar">
  {% if show_filters %}
    <button
      type="button"
      class="ag-coll__filter-toggle"
      aria-controls="CollectionFilterPanel"
      aria-expanded="false"
      data-filter-toggle
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
      {{ 'collections.filter' | t }}
      {% if active_count > 0 %}<span class="ag-coll__badge">{{ active_count }}</span>{% endif %}
    </button>
  {% endif %}

  <p class="ag-coll__count" role="status">
    {{ 'collections.works_count' | t: count: count }}
  </p>

  {% if enable_sorting %}
    <div class="ag-coll__sort">
      <label for="SortBy">{{ 'collections.sort_by' | t }}</label>
      <select id="SortBy" name="sort_by">
        {% for option in results.sort_options %}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>
            {{- option.name -}}
          </option>
        {% endfor %}
      </select>
    </div>
  {% endif %}
</div>

{% if active_count > 0 %}
  <ul class="ag-coll__chips" role="list">
    {% for filter in results.filters %}
      {% if filter.type == 'price_range' %}
        {% if filter.min_value.value != null or filter.max_value.value != null %}
          <li>
            <a class="ag-chip" href="{{ filter.url_to_remove }}">
              {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }} –
              {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }}
              <span aria-hidden="true">&times;</span>
              <span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span>
            </a>
          </li>
        {% endif %}
      {% else %}
        {% for value in filter.active_values %}
          <li>
            <a class="ag-chip" href="{{ value.url_to_remove }}">
              {{ value.label | escape }}
              <span aria-hidden="true">&times;</span>
              <span class="visually-hidden">{{ 'collections.remove_filter' | t }}</span>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    {% endfor %}
    <li><a class="ag-coll__clear" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a></li>
  </ul>
{% endif %}
