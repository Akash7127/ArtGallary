{% doc %}
  Artwork side of the split account pages (sign in, create account, reset).

  @param {image} [image] - The artwork image
  @param {string} [quote] - Optional quote shown over the image

  @example
  {% render 'auth-art', image: section.settings.image, quote: section.settings.quote %}
{% enddoc %}

<div class="ag-auth__art ag-media">
  {% if image %}
    {{ image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw', alt: '' }}
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag }}
  {% endif %}
  {% if quote != blank %}
    <blockquote class="ag-auth__quote ag-display">{{ quote }}</blockquote>
  {% endif %}
</div>
