{% doc %}
  Artist card for the artists page. Reads an "artist" metaobject with the
  fields name, portrait, practice and location.

  @param {object} [artist] - An artist metaobject. Leave out for a placeholder.
  @param {number} [index] - Position in the list, used to pick a placeholder drawing
  @param {string} [sizes] - The sizes attribute for the image

  @example
  {% render 'artist-card', artist: artist, sizes: '(min-width: 900px) 25vw, 50vw' %}
{% enddoc %}

{% liquid
  assign sizes = sizes | default: '(min-width: 900px) 25vw, 50vw'
  assign placeholder_index = index | default: 1 | modulo: 6 | plus: 1
  assign placeholder = 'collection-' | append: placeholder_index
  if artist
    assign name = artist.name.value | default: artist.system.handle
    assign url = artist.system.url | default: '#'
  else
    assign name = 'artists.placeholder_name' | t
    assign url = '#'
  endif
%}

<article class="ag-artist-card">
  <a href="{{ url }}">
    <div class="ag-media ag-artist-card__media">
      {% if artist.portrait.value %}
        {{
          artist.portrait.value
          | image_url: width: 800
          | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 540, 800', alt: name
        }}
      {% else %}
        {{ placeholder | placeholder_svg_tag }}
      {% endif %}
    </div>
    <h3 class="ag-artist-card__name">{{ name }}</h3>
    {% if artist.practice.value != blank or artist.location.value != blank %}
      <p class="ag-artist-card__meta">
        {{- artist.practice.value -}}
        {%- if artist.practice.value != blank and artist.location.value != blank %} · {% endif -%}
        {{- artist.location.value -}}
      </p>
    {% elsif artist == blank %}
      <p class="ag-artist-card__meta">{{ 'artists.placeholder_meta' | t }}</p>
    {% endif %}
  </a>
</article>

{% stylesheet %}
  .ag-artist-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .ag-artist-card__media {
    aspect-ratio: 4 / 5;
  }
  .ag-artist-card__media img {
    filter: grayscale(1);
    transition: filter 0.5s, transform 0.8s;
  }
  .ag-artist-card a:hover .ag-artist-card__media img {
    filter: grayscale(0);
  }
  .ag-artist-card__name {
    margin-top: 1rem;
    font-size: 1.4rem;
  }
  .ag-artist-card a:hover .ag-artist-card__name {
    color: var(--color-accent);
  }
  .ag-artist-card__meta {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}
