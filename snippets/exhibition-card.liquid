{% doc %}
  Exhibition card. Reads an "exhibition" metaobject with the fields
  title, subtitle, artist_names, start_date, end_date, location, cover, summary.
  The status (now showing / upcoming / past) is worked out from the dates.

  @param {object} [exhibition] - An exhibition metaobject. Leave out for a placeholder.
  @param {string} [style] - 'feature' (large, side by side), 'card' (default) or 'row' (compact archive row)
  @param {number} [index] - Position in the list, used to pick a placeholder drawing
  @param {string} [sizes] - The sizes attribute for the image

  @example
  {% render 'exhibition-card', exhibition: exhibition, style: 'feature' %}
{% enddoc %}

{% liquid
  assign style = style | default: 'card'
  assign placeholder_index = index | default: 1 | modulo: 6 | plus: 1
  assign placeholder = 'collection-' | append: placeholder_index
  if style == 'feature'
    assign sizes = sizes | default: '(min-width: 900px) 60vw, 100vw'
    assign img_width = 1600
  else
    assign sizes = sizes | default: '(min-width: 900px) 33vw, 100vw'
    assign img_width = 900
  endif

  if exhibition
    assign title = exhibition.title.value | default: exhibition.system.handle
    assign url = exhibition.system.url | default: '#'
  else
    assign title = 'exhibitions.placeholder_title' | t
    assign url = '#'
  endif
%}

<article class="ag-ex ag-ex--{{ style }}">
  {% unless style == 'row' %}
    <a class="ag-ex__media-link" href="{{ url }}" tabindex="-1" aria-hidden="true">
      <div class="ag-media ag-ex__media">
        {% if exhibition.cover.value %}
          {{
            exhibition.cover.value
            | image_url: width: img_width
            | image_tag: loading: 'lazy', sizes: sizes, alt: title
          }}
        {% else %}
          {{ placeholder | placeholder_svg_tag }}
        {% endif %}
      </div>
    </a>
  {% endunless %}

  <div class="ag-ex__body">
    <div class="ag-ex__meta">
      {% if exhibition %}
        {% render 'exhibition-status', exhibition: exhibition %}
      {% endif %}
      {% if exhibition.location.value != blank %}
        <span>{{ exhibition.location.value }}</span>
      {% endif %}
    </div>

    <h3 class="ag-ex__title"><a href="{{ url }}">{{ title }}</a></h3>

    {% if exhibition.subtitle.value != blank or exhibition.artist_names.value != blank %}
      <p class="ag-ex__artists">
        {{- exhibition.subtitle.value -}}
        {%- if exhibition.subtitle.value != blank and exhibition.artist_names.value != blank %} {% endif -%}
        {{- exhibition.artist_names.value -}}
      </p>
    {% elsif exhibition == blank %}
      <p class="ag-ex__artists">{{ 'exhibitions.placeholder_artists' | t }}</p>
    {% endif %}

    <p class="ag-ex__dates">{% render 'exhibition-dates', exhibition: exhibition %}</p>

    {% if style == 'feature' and exhibition.summary.value != blank %}
      <p class="ag-ex__summary">{{ exhibition.summary.value }}</p>
      <a class="ag-btn ag-btn--outline" href="{{ url }}">{{ 'exhibitions.view' | t }}</a>
    {% endif %}
  </div>
</article>

{% stylesheet %}
  .ag-ex__media {
    aspect-ratio: 3 / 2;
  }
  .ag-ex__body {
    padding-top: 1.25rem;
  }
  .ag-ex__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .ag-ex__title {
    margin-top: 0.85rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .ag-ex__title a {
    text-decoration: none;
  }
  .ag-ex__title a:hover {
    color: var(--color-accent);
  }
  .ag-ex__artists {
    margin-top: 0.4rem;
    color: var(--color-foreground-muted);
  }
  .ag-ex__dates {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ag-ex__summary {
    margin-block: 1.25rem 2rem;
    color: var(--color-foreground-muted);
  }
  .ag-ex--feature {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .ag-ex--feature .ag-ex__media {
    aspect-ratio: 4 / 3;
  }
  .ag-ex--feature .ag-ex__body {
    padding-top: 0;
  }
  .ag-ex--feature .ag-ex__title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }
  .ag-ex--row .ag-ex__body {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .ag-ex--row .ag-ex__meta {
    grid-row: 1 / span 2;
  }
  .ag-ex--row .ag-ex__title {
    margin: 0;
    font-size: 1.35rem;
  }
  .ag-ex--row .ag-ex__artists {
    grid-column: 2;
    margin: 0;
  }
  .ag-ex--row .ag-ex__dates {
    grid-column: 3;
    grid-row: 1;
    margin: 0;
    font-weight: 400;
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-ex--feature {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 750px) {
    .ag-ex--row .ag-ex__body {
      grid-template-columns: 1fr;
    }
    .ag-ex--row .ag-ex__meta,
    .ag-ex--row .ag-ex__artists,
    .ag-ex--row .ag-ex__dates {
      grid-column: 1;
      grid-row: auto;
    }
  }
{% endstylesheet %}
