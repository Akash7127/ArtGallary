{% doc %}
  New password and confirm password fields, with errors.

  @param {object} form - The reset or activate form object

  @example
  {% render 'password-fields', form: form %}
{% enddoc %}

{% if form.errors %}
  <div class="ag-form-errors" role="alert">{{ form.errors | default_errors }}</div>
{% endif %}
<div class="ag-field">
  <label for="NewPassword">{{ 'customers.reset.password' | t }}</label>
  <input
    type="password"
    id="NewPassword"
    name="customer[password]"
    autocomplete="new-password"
    minlength="5"
    required
    {% if form.errors contains 'password' %}
      aria-invalid="true"
    {% endif %}
  >
</div>
<div class="ag-field">
  <label for="ConfirmPassword">{{ 'customers.reset.password_confirm' | t }}</label>
  <input
    type="password"
    id="ConfirmPassword"
    name="customer[password_confirmation]"
    autocomplete="new-password"
    minlength="5"
    required
    {% if form.errors contains 'password_confirmation' %}
      aria-invalid="true"
    {% endif %}
  >
</div>
