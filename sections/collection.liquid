{% comment %}
  Artworks collection page: heading, filters (artist, medium, price,
  availability — set up in the Shopify Search & Discovery app), sorting,
  artwork grid and pagination.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% liquid
  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif

  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
%}

{{ 'facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<div class="ag-coll full-width" style="--coll-cols: {{ section.settings.columns }}">
  <header class="ag-coll__head">
    <div class="ag-coll__head-text">
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="ag-coll__title">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="ag-coll__desc">{{ collection.description }}</div>
      {% endif %}
    </div>
    {% if section.settings.show_image and collection.image %}
      <div class="ag-media ag-coll__head-media">
        {{
          collection.image
          | image_url: width: 1200
          | image_tag: loading: 'eager', sizes: '(min-width: 900px) 40vw, 100vw', alt: collection.title
        }}
      </div>
    {% endif %}
  </header>

  {% paginate collection.products by section.settings.per_page %}
    <form
      id="CollectionFilters"
      class="ag-coll__form"
      action="{{ collection.url }}"
      method="get"
      data-auto-submit
    >
      {% render 'facets-toolbar',
        results: collection,
        count: collection.products_count,
        show_filters: show_filters,
        enable_sorting: section.settings.enable_sorting,
        active_count: active_count,
        sort_by: sort_by,
        clear_url: clear_url
      %}


      <div class="ag-coll__body{% if show_filters %} ag-coll__body--filters{% endif %}">
        {% if show_filters %}
          {% render 'facets-panel', results: collection, active_count: active_count, clear_url: clear_url %}
        {% endif %}

        <div class="ag-coll__results">
          {% if collection.products.size > 0 %}
            <ul class="ag-coll__grid" role="list">
              {% for product in collection.products %}
                <li>
                  {% render 'artwork-card',
                    product: product,
                    index: forloop.index,
                    sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw'
                  %}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <div class="ag-coll__empty">
              {% if active_count > 0 %}
                <h2>{{ 'collections.no_matches' | t }}</h2>
                <p>{{ 'collections.no_matches_text' | t }}</p>
                <a class="ag-btn ag-btn--outline" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
              {% else %}
                <h2>{{ 'collections.empty' | t }}</h2>
                <p>{{ 'collections.empty_text' | t }}</p>
                <a class="ag-btn ag-btn--outline" href="{{ routes.all_products_collection_url }}">
                  {{- 'collections.browse_all' | t -}}
                </a>
              {% endif %}
            </div>
          {% endif %}

          {% render 'pagination', paginate: paginate %}
        </div>
      </div>

      <noscript>
        <button type="submit" class="ag-btn">{{ 'collections.show_results' | t }}</button>
      </noscript>
    </form>
  {% endpaginate %}
</div>


{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Artworks" },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    {
      "type": "range",
      "id": "per_page",
      "min": 12,
      "max": 36,
      "step": 4,
      "label": "Artworks per page",
      "default": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4",
      "info": "One column is used by filters when they are shown."
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Show filters",
      "default": true,
      "info": "Choose filters (artist, medium, price) in the Shopify Search & Discovery app."
    },
    { "type": "checkbox", "id": "enable_sorting", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
