{% comment %}
  "Opening soon" page shown while the store is password protected.
  Visitors can join the mailing list; the owner can enter the password.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="ag-pw full-width">
  <div class="ag-pw__art ag-media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw', alt: ''
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
    {% if section.settings.caption != blank %}
      <p class="ag-pw__caption">{{ section.settings.caption }}</p>
    {% endif %}
  </div>

  <div class="ag-pw__panel">
    <p class="ag-pw__brand ag-display">{{ shop.name }}</p>

    <div class="ag-pw__content">
      {% if section.settings.eyebrow != blank %}
        <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="ag-pw__heading">{{ section.settings.heading }}</h1>
      {% if shop.password_message != blank %}
        <p class="ag-pw__text">{{ shop.password_message }}</p>
      {% elsif section.settings.text != blank %}
        <div class="ag-pw__text">{{ section.settings.text }}</div>
      {% endif %}

      {% form 'customer', id: 'PasswordNewsletter', class: 'ag-pw__signup' %}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {% if form.posted_successfully? %}
          <p class="ag-pw__success" role="status">{{ 'password.signup_success' | t }}</p>
        {% else %}
          <div class="ag-newsletter__field">
            <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'newsletter.email' | t }}</label>
            <input
              id="PasswordNewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'newsletter.email' | t }}"
              required
            >
            <button class="ag-btn" type="submit">{{ 'password.notify' | t }}</button>
          </div>
          {% if form.errors %}
            <p class="ag-pw__error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>

    {% form 'storefront_password', class: 'ag-pw__owner' %}
      <details{% if form.errors %} open{% endif %}>
        <summary>{{ 'password.toggle' | t }}</summary>
        <div class="ag-pw__owner-body">
          <label for="password-input">{{ 'password.password' | t }}</label>
          <div class="ag-pw__owner-row">
            <input
              type="password"
              name="password"
              id="password-input"
              autocomplete="current-password"
              {% if form.errors %}
                aria-invalid="true" aria-describedby="PasswordError"
              {% endif %}
            >
            <button class="ag-btn ag-btn--outline" type="submit">{{ 'password.enter' | t }}</button>
          </div>
          {% if form.errors %}
            <p id="PasswordError" class="ag-pw__error">{{ 'password.wrong' | t }}</p>
          {% endif %}
        </div>
      </details>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .ag-pw {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 100svh;
  }
  .ag-pw__art {
    position: relative;
    min-height: 40vh;
  }
  .ag-pw__art img,
  .ag-pw__art svg {
    position: absolute;
    inset: 0;
  }
  .ag-pw__caption {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    padding: 0.6rem 1rem;
    background: var(--color-background);
    font-size: 0.8rem;
  }
  .ag-pw__panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    padding: clamp(2rem, 5vw, 4.5rem);
  }
  .ag-pw__brand {
    font-size: 1.6rem;
  }
  .ag-pw__content {
    max-width: 32rem;
  }
  .ag-pw__heading {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    line-height: 1.02;
  }
  .ag-pw__text {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--color-foreground-muted);
  }
  .ag-pw__signup {
    margin-top: 2.5rem;
  }
  .ag-pw__success {
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface);
  }
  .ag-pw__error {
    margin-top: 0.75rem;
    color: var(--color-accent);
  }
  .ag-pw__owner {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .ag-pw__owner summary {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    cursor: pointer;
    color: var(--color-foreground-muted);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .ag-pw__owner-body {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .ag-pw__owner-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ag-pw__owner-row input {
    flex: 1 1 12rem;
    min-height: 3rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
  }
  @media (max-width: 900px) {
    .ag-pw {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 750px) {
    .ag-newsletter__field {
      flex-direction: column;
      border-radius: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Artwork image" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "Featured work · new collection" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new home for original art" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text (used when no password message is set in Preferences)",
      "default": "<p>We're hanging the first works now. Leave your email and we'll invite you to the opening.</p>"
    }
  ]
}
{% endschema %}
