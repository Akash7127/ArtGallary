{% comment %}
  Artwork page: image viewer, artist and title, artwork details, price,
  options (e.g. original / print sizes), add to cart or enquire, and
  information panels.

  Optional product metafields (Settings > Custom data > Products):
    custom.year, custom.medium, custom.dimensions, custom.edition,
    custom.framing (single line text) and custom.artist_bio (multi-line text).
  If custom.medium is empty, the product type is used as the medium.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign mf = product.metafields.custom
  assign medium = mf.medium.value | default: product.type
  assign enquire_url = section.settings.enquire_link | default: '/pages/contact'
  if enquire_url contains '?'
    assign enquire_url = enquire_url | append: '&'
  else
    assign enquire_url = enquire_url | append: '?'
  endif
  assign encoded = product.title | url_encode
  assign enquire_url = enquire_url | append: 'topic=artwork&artwork=' | append: encoded
  assign main_collection = collection | default: product.collections.first
%}

<div class="ag-product full-width" data-product-section>
  <nav class="ag-product__crumbs" aria-label="{{ 'product.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'product.home' | t }}</a>
    <span aria-hidden="true">/</span>
    {% if main_collection %}
      <a href="{{ main_collection.url }}">{{ main_collection.title | escape }}</a>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">{{ 'product.artworks' | t }}</a>
    {% endif %}
  </nav>

  <div class="ag-product__grid">
    {%- comment -%} Media {%- endcomment -%}
    <div class="ag-product__media">
      <button
        type="button"
        class="ag-product__stage ag-media"
        data-zoom-open
        aria-label="{{ 'product.zoom' | t }}"
        {% unless featured_media %}
          disabled
        {% endunless %}
      >
        {% if featured_media %}
          {{
            featured_media
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 900px) 58vw, 100vw',
              widths: '600, 900, 1200, 1500, 1800',
              alt: featured_media.alt
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </button>

      {% if product.media.size > 1 %}
        <ul class="ag-product__thumbs" role="list">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <li>
                <a
                  class="ag-product__thumb ag-media"
                  href="{{ media | image_url: width: 1800 }}"
                  data-thumb
                  data-media-id="{{ media.id }}"
                  data-full="{{ media | image_url: width: 1800 }}"
                  data-alt="{{ media.alt | escape }}"
                  {% if media.id == featured_media.id %}
                    aria-current="true"
                  {% endif %}
                >
                  {{ media | image_url: width: 240 | image_tag: loading: 'lazy', alt: media.alt }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.show_scale_note %}
        <p class="ag-product__note">{{ 'product.colour_note' | t }}</p>
      {% endif %}
    </div>

    {%- comment -%} Details {%- endcomment -%}
    <div class="ag-product__info">
      {% if product.vendor != blank %}
        <a class="ag-product__artist" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
      {% endif %}

      <h1 class="ag-product__title">
        {{ product.title | escape -}}
        {%- if mf.year.value != blank -%}
          <span class="ag-product__year">, {{ mf.year.value }}</span>
        {%- endif %}
      </h1>

      <dl class="ag-product__specs">
        {% if medium != blank %}
          <div>
            <dt>{{ 'product.medium' | t }}</dt>
            <dd>{{ medium }}</dd>
          </div>
        {% endif %}
        {% if mf.dimensions.value != blank %}
          <div>
            <dt>{{ 'product.dimensions' | t }}</dt>
            <dd>{{ mf.dimensions.value }}</dd>
          </div>
        {% endif %}
        {% if mf.edition.value != blank %}
          <div>
            <dt>{{ 'product.edition' | t }}</dt>
            <dd>{{ mf.edition.value }}</dd>
          </div>
        {% endif %}
        {% if mf.framing.value != blank %}
          <div>
            <dt>{{ 'product.framing' | t }}</dt>
            <dd>{{ mf.framing.value }}</dd>
          </div>
        {% endif %}
      </dl>

      {% form 'product', product, class: 'ag-product__form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1">

        <div class="ag-product__price-row">
          <p class="ag-product__price" data-price>
            {% if current_variant.available %}
              {{ current_variant.price | money }}
            {% else %}
              {{ 'artworks.sold' | t }}
            {% endif %}
          </p>
          {% if current_variant.compare_at_price > current_variant.price %}
            <s class="ag-product__compare" data-compare>{{ current_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>

        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            <fieldset class="ag-product__option">
              <legend>{{ option.name | escape }}</legend>
              <div class="ag-product__pills">
                {% for value in option.values %}
                  {% assign value_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 %}
                  <input
                    type="radio"
                    id="Option-{{ value_id }}"
                    name="option-{{ option_index }}"
                    value="{{ value | escape }}"
                    data-option-index="{{ option_index }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  <label for="Option-{{ value_id }}">{{ value | escape }}</label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}

        <div class="ag-product__actions">
          <button
            type="submit"
            name="add"
            class="ag-btn ag-product__add"
            data-add-button
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              {{ 'product.add_to_cart' | t }}
            {% else %}
              {{ 'artworks.sold' | t }}
            {% endif %}
          </button>
          {% if section.settings.show_dynamic_checkout %}
            <div class="ag-product__dynamic" data-dynamic-checkout>{{ form | payment_button }}</div>
          {% endif %}
          {% if section.settings.show_enquire %}
            <a class="ag-btn ag-btn--outline" href="{{ enquire_url }}">{{ 'product.enquire' | t }}</a>
          {% endif %}
        </div>
      {% endform %}

      {% if section.settings.assurance_1 != blank
        or section.settings.assurance_2 != blank
        or section.settings.assurance_3 != blank
      %}
        <ul class="ag-product__assure" role="list">
          {% for i in (1..3) %}
            {% assign key = 'assurance_' | append: i %}
            {% if section.settings[key] != blank %}
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>
                {{ section.settings[key] }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      <div class="ag-product__panels">
        {% if product.description != blank %}
          <details class="ag-panel" open>
            <summary>{{ 'product.about_work' | t }}</summary>
            <div class="ag-panel__body ag-rte">{{ product.description }}</div>
          </details>
        {% endif %}
        {% if mf.artist_bio.value != blank %}
          <details class="ag-panel">
            <summary>{{ 'product.about_artist' | t }}</summary>
            <div class="ag-panel__body ag-rte">
              {{ mf.artist_bio.value | newline_to_br }}
              {% if product.vendor != blank %}
                <p>
                  <a class="ag-link" href="{{ product.vendor | url_for_vendor }}">
                    {{- 'product.more_by' | t: artist: product.vendor }} &rarr;
                  </a>
                </p>
              {% endif %}
            </div>
          </details>
        {% endif %}
        {% if section.settings.shipping_text != blank %}
          <details class="ag-panel">
            <summary>{{ 'product.shipping' | t }}</summary>
            <div class="ag-panel__body ag-rte">{{ section.settings.shipping_text }}</div>
          </details>
        {% endif %}
      </div>
    </div>
  </div>

  <dialog class="ag-zoom" data-zoom aria-label="{{ 'product.zoom' | t }}">
    <button type="button" class="ag-zoom__close" data-zoom-close aria-label="{{ 'product.close' | t }}">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    </button>
    <div class="ag-zoom__frame" data-zoom-frame></div>
  </dialog>

  <script type="application/json" data-product-json>
    {
      "variants": {{ product.variants | json }},
      "prices": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": { "price": {{ variant.price | money | json }}, "compare": {{ variant.compare_at_price | money | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      },
      "media": {
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            "{{ media.id }}": { "src": {{ media | image_url: width: 1800 | json }}, "alt": {{ media.alt | json }} }{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      },
      "soldText": {{ 'artworks.sold' | t | json }},
      "addText": {{ 'product.add_to_cart' | t | json }},
      "unavailableText": {{ 'product.unavailable' | t | json }}
    }
  </script>
</div>

{% javascript %}
  (function () {
    document.querySelectorAll('[data-product-section]').forEach(function (root) {
      var dataEl = root.querySelector('[data-product-json]');
      var data = dataEl ? JSON.parse(dataEl.textContent) : { variants: [], media: {} };
      var stage = root.querySelector('.ag-product__stage img');
      var thumbs = root.querySelectorAll('[data-thumb]');
      var form = root.querySelector('.ag-product__form');

      function showMedia(id, src, alt) {
        if (!stage || !src) return;
        stage.removeAttribute('srcset');
        stage.src = src;
        stage.alt = alt || '';
        thumbs.forEach(function (t) {
          if (t.dataset.mediaId === String(id)) t.setAttribute('aria-current', 'true');
          else t.removeAttribute('aria-current');
        });
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function (event) {
          event.preventDefault();
          showMedia(thumb.dataset.mediaId, thumb.dataset.full, thumb.dataset.alt);
        });
      });

      // Zoom dialog
      var dialog = root.querySelector('[data-zoom]');
      var opener = root.querySelector('[data-zoom-open]');
      if (dialog && opener && stage && dialog.showModal) {
        opener.addEventListener('click', function () {
          var frame = dialog.querySelector('[data-zoom-frame]');
          var img = new Image();
          img.src = stage.currentSrc || stage.src;
          img.alt = stage.alt;
          frame.replaceChildren(img);
          dialog.showModal();
        });
        dialog.querySelector('[data-zoom-close]').addEventListener('click', function () { dialog.close(); });
        dialog.addEventListener('click', function (event) {
          if (event.target === dialog) dialog.close();
        });
      }

      // Variant options
      if (!form) return;
      var radios = form.querySelectorAll('input[data-option-index]');
      if (!radios.length) return;
      var idInput = form.querySelector('[data-variant-id]');
      var priceEl = form.querySelector('[data-price]');
      var compareEl = form.querySelector('[data-compare]');
      var addBtn = form.querySelector('[data-add-button]');
      var dynamic = form.querySelector('[data-dynamic-checkout]');

      form.addEventListener('change', function (event) {
        if (!event.target.matches('input[data-option-index]')) return;
        var selected = [];
        form.querySelectorAll('input[data-option-index]:checked').forEach(function (r) {
          selected[Number(r.dataset.optionIndex)] = r.value;
        });
        var variant = data.variants.find(function (v) {
          return v.options.every(function (o, i) { return o === selected[i]; });
        });

        if (!variant) {
          addBtn.disabled = true;
          addBtn.textContent = data.unavailableText;
          priceEl.textContent = data.unavailableText;
          if (dynamic) dynamic.hidden = true;
          return;
        }

        idInput.value = variant.id;
        addBtn.disabled = !variant.available;
        addBtn.textContent = variant.available ? data.addText : data.soldText;
        priceEl.textContent = variant.available ? data.prices[variant.id].price : data.soldText;
        if (compareEl) {
          compareEl.hidden = !(variant.compare_at_price > variant.price);
          if (!compareEl.hidden) compareEl.textContent = data.prices[variant.id].compare;
        }
        if (dynamic) dynamic.hidden = !variant.available;

        if (variant.featured_media && data.media[variant.featured_media.id]) {
          var m = data.media[variant.featured_media.id];
          showMedia(variant.featured_media.id, m.src, m.alt);
        }

        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());
      });
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .ag-product {
    width: var(--content-width);
    margin-inline: auto;
    padding-block: 1.5rem var(--section-space);
  }
  .ag-product__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    color: var(--color-foreground-muted);
  }
  .ag-product__crumbs a {
    text-decoration: none;
  }
  .ag-product__crumbs a:hover {
    color: var(--color-accent);
  }
  .ag-product__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .ag-product__stage {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 0;
    cursor: zoom-in;
  }
  .ag-product__stage:disabled {
    cursor: default;
  }
  .ag-product__stage img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.45);
  }
  .ag-product__stage:hover img {
    transform: none;
  }
  .ag-product__thumbs {
    display: flex;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }
  .ag-product__thumb {
    display: block;
    width: 5rem;
    aspect-ratio: 1 / 1;
    border: 1px solid transparent;
    opacity: 0.65;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .ag-product__thumb:hover,
  .ag-product__thumb[aria-current] {
    opacity: 1;
  }
  .ag-product__thumb[aria-current] {
    border-color: var(--color-foreground);
  }
  .ag-product__note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-foreground-muted);
  }
  .ag-product__info {
    position: sticky;
    top: 6.5rem;
  }
  .ag-product__artist {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent);
  }
  .ag-product__artist:hover {
    text-decoration: underline;
  }
  .ag-product__title {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-style: italic;
  }
  .ag-product__year {
    font-style: normal;
    color: var(--color-foreground-muted);
  }
  .ag-product__specs {
    display: grid;
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--color-border);
  }
  .ag-product__specs div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.92rem;
  }
  .ag-product__specs dt {
    color: var(--color-foreground-muted);
  }
  .ag-product__specs dd {
    margin: 0;
  }
  .ag-product__form {
    margin-top: 1.75rem;
  }
  .ag-product__price-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .ag-product__price {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
  }
  .ag-product__compare {
    color: var(--color-foreground-muted);
  }
  .ag-product__option {
    margin: 1.5rem 0 0;
    padding: 0;
    border: 0;
  }
  .ag-product__option legend {
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ag-product__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ag-product__pills input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .ag-product__pills label {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .ag-product__pills label:hover {
    border-color: var(--color-foreground);
  }
  .ag-product__pills input:checked + label {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .ag-product__pills input:focus-visible + label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .ag-product__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .ag-product__add:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }
  .ag-product__dynamic .shopify-payment-button__button {
    min-height: 3rem;
    border-radius: 999px;
    overflow: hidden;
  }
  .ag-product__assure {
    display: grid;
    gap: 0.6rem;
    margin: 1.75rem 0 0;
    padding: 1.25rem;
    background: var(--color-surface);
    list-style: none;
    font-size: 0.9rem;
  }
  .ag-product__assure li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ag-product__assure svg {
    flex: none;
    color: var(--color-accent);
  }
  .ag-product__panels {
    margin-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .ag-panel {
    border-bottom: 1px solid var(--color-border);
  }
  .ag-panel summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }
  .ag-panel summary::-webkit-details-marker {
    display: none;
  }
  .ag-panel summary::after {
    content: '+';
    font-size: 1.15rem;
    font-weight: 400;
  }
  .ag-panel[open] summary::after {
    content: '–';
  }
  .ag-panel__body {
    padding-bottom: 1.5rem;
    color: var(--color-foreground-muted);
  }
  .ag-zoom {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: var(--color-background);
  }
  .ag-zoom::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .ag-zoom[open] {
    display: grid;
    place-items: center;
  }
  .ag-zoom img {
    max-width: 100%;
    max-height: calc(100svh - 6rem);
    object-fit: contain;
  }
  .ag-zoom__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-surface);
    color: inherit;
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .ag-product__grid {
      grid-template-columns: 1fr;
    }
    .ag-product__info {
      position: static;
    }
    .ag-product__stage {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy it now button", "default": true },
    { "type": "checkbox", "id": "show_enquire", "label": "Show Enquire button", "default": true },
    {
      "type": "url",
      "id": "enquire_link",
      "label": "Enquire link",
      "info": "Defaults to /pages/contact. The artwork's title is filled in for the visitor."
    },
    { "type": "checkbox", "id": "show_scale_note", "label": "Show colour note under the image", "default": true },
    { "type": "header", "content": "Assurances" },
    { "type": "text", "id": "assurance_1", "label": "Line 1", "default": "Certificate of authenticity included" },
    { "type": "text", "id": "assurance_2", "label": "Line 2", "default": "Insured shipping, packed by hand" },
    { "type": "text", "id": "assurance_3", "label": "Line 3", "default": "14-day returns on originals" },
    { "type": "header", "content": "Shipping panel" },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping and returns text",
      "default": "<p>Paintings ship rolled or stretched in custom crates within 5–7 working days. Every work is fully insured until it reaches you. If the work is not right for your space, contact us within 14 days of delivery to arrange a return.</p>"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
