{% comment %}
  Exhibitions: one large "now showing" feature followed by smaller
  cards for upcoming or online shows. Each block is one exhibition.
{% endcomment %}

<section class="ag-exhibitions ag-section ag-section--surface full-width">
  <div class="ag-exhibitions__inner">
    <div class="ag-section-head">
      <div>
        <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank %}
        <a class="ag-link" href="{{ section.settings.link | default: routes.root_url }}">
          {{- section.settings.link_label }} &rarr;
        </a>
      {% endif %}
    </div>

    <div class="ag-exhibitions__list">
      {% for block in section.blocks %}
        {% liquid
          assign url = block.settings.link | default: '#'
          if forloop.first
            assign card_class = 'ag-show ag-show--feature'
            assign img_width = 1600
            assign placeholder = 'lifestyle-2'
          else
            assign card_class = 'ag-show'
            assign img_width = 900
            assign placeholder = 'collection-' | append: forloop.index
          endif
        %}
        <article class="{{ card_class }}" {{ block.shopify_attributes }}>
          <a class="ag-show__media-link" href="{{ url }}" tabindex="-1" aria-hidden="true">
            <div class="ag-media ag-show__media">
              {% if block.settings.image %}
                {{
                  block.settings.image
                  | image_url: width: img_width
                  | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', alt: block.settings.title
                }}
              {% else %}
                {{ placeholder | placeholder_svg_tag }}
              {% endif %}
            </div>
          </a>
          <div class="ag-show__body">
            <div class="ag-show__meta">
              {% if block.settings.status != blank %}
                <span class="ag-show__status">{{ block.settings.status }}</span>
              {% endif %}
              <span>{{ block.settings.location }}</span>
            </div>
            <h3 class="ag-show__title">
              <a href="{{ url }}">{{ block.settings.title }}</a>
            </h3>
            {% if block.settings.artists != blank %}
              <p class="ag-show__artists">{{ block.settings.artists }}</p>
            {% endif %}
            <p class="ag-show__dates">{{ block.settings.dates }}</p>
            {% if forloop.first and block.settings.text != blank %}
              <div class="ag-show__text">{{ block.settings.text }}</div>
              <a class="ag-btn ag-btn--outline" href="{{ url }}">{{ 'exhibitions.view' | t }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ag-exhibitions__inner {
    width: var(--content-width);
    margin-inline: auto;
  }
  .ag-exhibitions__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }
  .ag-show__media {
    aspect-ratio: 3 / 2;
  }
  .ag-show__body {
    padding-top: 1.25rem;
  }
  .ag-show__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .ag-show__status {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .ag-show__title {
    margin-top: 0.85rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }
  .ag-show__title a {
    text-decoration: none;
  }
  .ag-show__title a:hover {
    color: var(--color-accent);
  }
  .ag-show__artists {
    margin-top: 0.4rem;
    color: var(--color-foreground-muted);
  }
  .ag-show__dates {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ag-show--feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }
  .ag-show--feature .ag-show__media {
    aspect-ratio: 4 / 3;
  }
  .ag-show--feature .ag-show__body {
    padding-top: 0;
  }
  .ag-show--feature .ag-show__title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }
  .ag-show__text {
    margin-block: 1.25rem 2rem;
    color: var(--color-foreground-muted);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 900px) {
    .ag-exhibitions__list,
    .ag-show--feature {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Exhibitions",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "On view" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exhibitions" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All exhibitions" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "exhibition",
      "name": "Exhibition",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "status", "label": "Status tag", "default": "Now showing" },
        { "type": "text", "id": "location", "label": "Location", "default": "Main gallery" },
        { "type": "text", "id": "title", "label": "Title", "default": "Exhibition title" },
        { "type": "text", "id": "artists", "label": "Artists", "default": "A solo exhibition" },
        { "type": "text", "id": "dates", "label": "Dates", "default": "1 Dec 2026 – 15 Jan 2027" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Short description (first exhibition only)",
          "default": "<p>Add a few lines about the exhibition.</p>"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exhibitions",
      "blocks": [{ "type": "exhibition" }, { "type": "exhibition" }, { "type": "exhibition" }]
    }
  ]
}
{% endschema %}
