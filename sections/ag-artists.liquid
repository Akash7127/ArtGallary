{% comment %}
  Artists: a horizontal, scroll-snapping row of artist cards.
  Each block is one artist.
{% endcomment %}

<section class="ag-artists ag-section ag-section--dark full-width">
  <div class="ag-artists__inner">
    <div class="ag-section-head">
      <div>
        <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank %}
        <a class="ag-link" href="{{ section.settings.link | default: routes.root_url }}">
          {{- section.settings.link_label }} &rarr;
        </a>
      {% endif %}
    </div>
  </div>

  <ul class="ag-artists__row" role="list">
    {% for block in section.blocks %}
      {% assign url = block.settings.link | default: '#' %}
      <li class="ag-artist" {{ block.shopify_attributes }}>
        <a href="{{ url }}">
          <div class="ag-media ag-artist__media">
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 22vw, 70vw', alt: block.settings.name
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <h3 class="ag-artist__name">{{ block.settings.name }}</h3>
          <p class="ag-artist__practice">{{ block.settings.practice }}</p>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .ag-section--dark {
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .ag-section--dark .ag-eyebrow {
    color: color-mix(in srgb, var(--color-accent) 55%, white);
  }
  .ag-artists__inner {
    width: var(--content-width);
    margin-inline: auto;
  }
  .ag-artists__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(14rem, 22vw, 19rem);
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0 max(var(--page-margin), calc((100% - var(--page-width)) / 2 + var(--page-margin))) 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--page-margin), calc((100% - var(--page-width)) / 2 + var(--page-margin)));
    scrollbar-width: thin;
    scrollbar-color: rgb(255 255 255 / 0.3) transparent;
  }
  .ag-artist {
    scroll-snap-align: start;
  }
  .ag-artist a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .ag-artist__media {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0 0;
    background: rgb(255 255 255 / 0.06);
  }
  .ag-artist__media img {
    filter: grayscale(1);
    transition: filter 0.5s, transform 0.8s;
  }
  .ag-artist a:hover .ag-artist__media img {
    filter: grayscale(0);
  }
  .ag-artist__name {
    margin-top: 1.1rem;
    font-size: 1.4rem;
  }
  .ag-artist__practice {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artists",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Represented artists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The artists" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All artists" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait or artwork" },
        { "type": "text", "id": "name", "label": "Name", "default": "Artist name" },
        { "type": "text", "id": "practice", "label": "Practice", "default": "Painting" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artists",
      "blocks": [{ "type": "artist" }, { "type": "artist" }, { "type": "artist" }, { "type": "artist" }]
    }
  ]
}
{% endschema %}
