{% comment %}
  Team: people behind the gallery. Each block is one person.
{% endcomment %}

<div class="ag-team ag-section">
  <div class="ag-section-head">
    <div>
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.text != blank %}
      <div class="ag-team__intro">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  <ul class="ag-team__grid" role="list">
    {% for block in section.blocks %}
      <li class="ag-person" {{ block.shopify_attributes }}>
        <div class="ag-media ag-person__media">
          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: 700
              | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', alt: block.settings.name
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <h3 class="ag-person__name">{{ block.settings.name }}</h3>
        <p class="ag-person__role">{{ block.settings.role }}</p>
        {% if block.settings.bio != blank %}
          <p class="ag-person__bio">{{ block.settings.bio }}</p>
        {% endif %}
        {% if block.settings.email != blank %}
          <a class="ag-person__email" href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .ag-team__intro {
    max-width: 30rem;
    color: var(--color-foreground-muted);
  }
  .ag-team__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-person__media {
    aspect-ratio: 1 / 1;
    border-radius: 999px;
  }
  .ag-person__media img {
    filter: grayscale(1);
  }
  .ag-person__name {
    margin-top: 1.1rem;
    font-size: 1.35rem;
  }
  .ag-person__role {
    margin-top: 0.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .ag-person__bio {
    margin-top: 0.75rem;
    font-size: 0.92rem;
    color: var(--color-foreground-muted);
  }
  .ag-person__email {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.88rem;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 900px) {
    .ag-team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Team",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People behind the gallery" },
    { "type": "richtext", "id": "text", "label": "Introduction" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Full name" },
        { "type": "text", "id": "role", "label": "Role", "default": "Role" },
        { "type": "textarea", "id": "bio", "label": "Short bio" },
        { "type": "text", "id": "email", "label": "Email" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team",
      "blocks": [{ "type": "person" }, { "type": "person" }, { "type": "person" }, { "type": "person" }]
    }
  ]
}
{% endschema %}
