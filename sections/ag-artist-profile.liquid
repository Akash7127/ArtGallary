{% comment %}
  Single artist page, rendered for each "artist" metaobject entry
  (templates/metaobject/artist.json).

  Fields used: name, portrait, practice, location, born, bio, artworks.
  If "artworks" is empty, the page shows products whose vendor matches
  the artist's name (from the first 50 products in the store).
{% endcomment %}

{% liquid
  assign artist = metaobject
  assign name = artist.name.value | default: artist.system.handle
  assign works = artist.artworks.value
  assign works_from_vendor = false
  if works == blank or works.count == 0
    assign works_from_vendor = true
  endif
  assign vendor_url = name | url_for_vendor
  assign back_url = section.settings.back_link | default: '/pages/artists'
%}

<div class="ag-profile full-width">
  <nav class="ag-profile__crumbs" aria-label="{{ 'product.breadcrumbs' | t }}">
    <a href="{{ back_url }}">&larr; {{ 'artists.all_artists' | t }}</a>
  </nav>

  <div class="ag-profile__head">
    <div class="ag-media ag-profile__portrait">
      {% if artist.portrait.value %}
        {{
          artist.portrait.value
          | image_url: width: 1200
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 40vw, 100vw', alt: name
        }}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="ag-profile__text">
      {% if artist.practice.value != blank %}
        <span class="ag-eyebrow">{{ artist.practice.value }}</span>
      {% endif %}
      <h1 class="ag-profile__name">{{ name }}</h1>

      {% if artist.location.value != blank or artist.born.value != blank %}
        <dl class="ag-profile__facts">
          {% if artist.born.value != blank %}
            <div>
              <dt>{{ 'artists.born' | t }}</dt>
              <dd>{{ artist.born.value }}</dd>
            </div>
          {% endif %}
          {% if artist.location.value != blank %}
            <div>
              <dt>{{ 'artists.lives_works' | t }}</dt>
              <dd>{{ artist.location.value }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {% if artist.bio != blank %}
        <div class="ag-profile__bio ag-rte">{{ artist.bio | metafield_tag }}</div>
      {% endif %}

      <div class="ag-profile__actions">
        <a class="ag-btn" href="#Works-{{ section.id }}">{{ 'artists.see_works' | t }}</a>
        {% if section.settings.enquire_link != blank %}
          <a class="ag-btn ag-btn--outline" href="{{ section.settings.enquire_link }}">
            {{- 'artists.enquire' | t -}}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <section class="ag-profile__works" id="Works-{{ section.id }}" aria-labelledby="WorksHeading-{{ section.id }}">
    <div class="ag-section-head">
      <h2 id="WorksHeading-{{ section.id }}">{{ 'artists.works_by' | t: artist: name }}</h2>
      <a class="ag-link" href="{{ vendor_url }}">{{ 'artists.view_all_works' | t }} &rarr;</a>
    </div>

    {% assign shown = 0 %}
    <ul class="ag-profile__grid" role="list">
      {% if works_from_vendor %}
        {% for product in collections.all.products %}
          {% if product.vendor == name and shown < section.settings.limit %}
            {% assign shown = shown | plus: 1 %}
            <li>{% render 'artwork-card', product: product, index: shown %}</li>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for product in works limit: section.settings.limit %}
          {% assign shown = shown | plus: 1 %}
          <li>{% render 'artwork-card', product: product, index: shown %}</li>
        {% endfor %}
      {% endif %}
    </ul>

    {% if shown == 0 %}
      <p class="ag-profile__empty">{{ 'artists.no_works' | t }}</p>
    {% endif %}
  </section>
</div>

{% stylesheet %}
  .ag-profile {
    width: var(--content-width);
    margin-inline: auto;
    padding: 1.5rem 0 var(--section-space);
  }
  .ag-profile__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-foreground-muted);
  }
  .ag-profile__crumbs a:hover {
    color: var(--color-accent);
  }
  .ag-profile__head {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    margin-top: 1rem;
  }
  .ag-profile__portrait {
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 0 0;
  }
  .ag-profile__text {
    padding-top: clamp(0rem, 4vw, 3rem);
  }
  .ag-profile__name {
    margin-top: 1rem;
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .ag-profile__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.75rem 0 0;
    padding-block: 1rem;
    border-block: 1px solid var(--color-border);
  }
  .ag-profile__facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .ag-profile__facts dd {
    margin: 0.25rem 0 0;
  }
  .ag-profile__bio {
    max-width: 40rem;
    margin-top: 1.75rem;
    font-size: 1.02rem;
    color: var(--color-foreground-muted);
  }
  .ag-profile__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .ag-profile__works {
    margin-top: var(--section-space);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }
  .ag-profile__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-profile__grid:empty {
    display: none;
  }
  .ag-profile__empty {
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-profile__head {
      grid-template-columns: 1fr;
    }
    .ag-profile__portrait {
      max-width: 28rem;
    }
    .ag-profile__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist profile",
  "tag": "section",
  "settings": [
    { "type": "url", "id": "back_link", "label": "\"All artists\" link", "info": "Defaults to /pages/artists." },
    { "type": "url", "id": "enquire_link", "label": "Enquire link", "info": "For example your Contact page." },
    { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 4, "label": "Artworks to show", "default": 12 }
  ]
}
{% endschema %}
