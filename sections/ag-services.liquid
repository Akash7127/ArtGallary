{% comment %}
  Services: numbered list of what the gallery offers beside an image.
  Each block is one service.
{% endcomment %}

<section class="ag-services ag-section">
  <div class="ag-services__grid">
    <div class="ag-services__aside">
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="ag-services__heading">{{ section.settings.heading }}</h2>
      <div class="ag-media ag-services__media">
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 40vw, 100vw'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
    </div>

    <ol class="ag-services__list" role="list">
      {% for block in section.blocks %}
        <li class="ag-service" {{ block.shopify_attributes }}>
          <span class="ag-service__num ag-display">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div>
            <h3 class="ag-service__title">{{ block.settings.title }}</h3>
            <div class="ag-service__text">{{ block.settings.text }}</div>
            {% if block.settings.link_label != blank %}
              <a class="ag-link" href="{{ block.settings.link | default: routes.root_url }}">
                {{- block.settings.link_label }} &rarr;
              </a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% stylesheet %}
  .ag-services__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .ag-services__aside {
    position: sticky;
    top: 7rem;
  }
  .ag-services__heading {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }
  .ag-services__media {
    aspect-ratio: 5 / 4;
    margin-top: 2rem;
  }
  .ag-services__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-service {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--color-border);
  }
  .ag-service:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .ag-service__num {
    font-size: 1.75rem;
    color: var(--color-accent);
  }
  .ag-service__title {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }
  .ag-service__text {
    margin-block: 0.75rem 1.25rem;
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-services__grid {
      grid-template-columns: 1fr;
    }
    .ag-services__aside {
      position: static;
    }
    .ag-service {
      grid-template-columns: 3rem 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Services",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Beyond the walls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we can help" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this service.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Enquire" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [{ "type": "service" }, { "type": "service" }, { "type": "service" }]
    }
  ]
}
{% endschema %}
