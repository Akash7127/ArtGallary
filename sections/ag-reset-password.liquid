{% comment %}
  Set a new password (from the reset email) and activate an invited
  account. Used by both customers/reset_password and
  customers/activate_account templates.
{% endcomment %}

{{ 'account.css' | asset_url | stylesheet_tag }}

{% liquid
  assign is_activate = false
  if template.name == 'activate_account'
    assign is_activate = true
  endif
%}

<div class="ag-auth full-width">
  {% render 'auth-art', image: section.settings.image, quote: section.settings.quote %}

  <div class="ag-auth__panel">
    <div class="ag-auth__login">
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      {% if is_activate %}
        <h1 class="ag-auth__title">{{ 'customers.activate.title' | t }}</h1>
        <p class="ag-auth__lead">{{ 'customers.activate.text' | t }}</p>
      {% else %}
        <h1 class="ag-auth__title">{{ 'customers.reset.title' | t }}</h1>
        <p class="ag-auth__lead">{{ 'customers.reset.text' | t }}</p>
      {% endif %}

      {% if is_activate %}
        {% form 'activate_customer_password', class: 'ag-auth__form' %}
          {% render 'password-fields', form: form %}
          <button type="submit" class="ag-btn">{{ 'customers.activate.submit' | t }}</button>
          <button type="submit" name="decline" class="ag-link ag-auth__guest">{{ 'customers.activate.decline' | t }}</button>
        {% endform %}
      {% else %}
        {% form 'reset_customer_password', class: 'ag-auth__form' %}
          {% render 'password-fields', form: form %}
          <button type="submit" class="ag-btn">{{ 'customers.reset.submit' | t }}</button>
        {% endform %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Set password",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Artwork image" },
    { "type": "text", "id": "quote", "label": "Quote over the image" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Collector account" }
  ],
  "enabled_on": { "templates": ["customers/reset_password", "customers/activate_account"] }
}
{% endschema %}
