{% comment %}
  Page hero: large heading and intro over a wide image. Works on any page.
{% endcomment %}

<div class="ag-phero full-width">
  <div class="ag-phero__text">
    {% if section.settings.eyebrow != blank %}
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="ag-phero__title">{{ section.settings.heading | default: page.title }}</h1>
    {% if section.settings.text != blank %}
      <div class="ag-phero__intro">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% if section.settings.show_image %}
    <div class="ag-media ag-phero__media">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {% endif %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .ag-phero__text {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: end;
    gap: 1rem clamp(2rem, 6vw, 6rem);
    width: var(--content-width);
    margin-inline: auto;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .ag-phero__text .ag-eyebrow {
    grid-column: 1 / -1;
  }
  .ag-phero__title {
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1;
  }
  .ag-phero__title em {
    color: var(--color-accent);
  }
  .ag-phero__intro {
    font-size: 1.1rem;
    color: var(--color-foreground-muted);
  }
  .ag-phero__media {
    height: clamp(18rem, 60vh, 40rem);
  }
  @media (max-width: 900px) {
    .ag-phero__text {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "About us" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
