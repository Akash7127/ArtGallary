{% comment %}
  Gallery statement: a large curatorial line next to short "about" text
  and a row of facts (blocks).
{% endcomment %}

<section class="ag-statement ag-section">
  <div class="ag-statement__grid">
    <div>
      {% if section.settings.eyebrow != blank %}
        <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
    </div>
    <div>
      <p class="ag-statement__lead ag-display">{{ section.settings.lead }}</p>
      {% if section.settings.text != blank %}
        <div class="ag-statement__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a class="ag-link" href="{{ section.settings.link | default: routes.root_url }}">
          {{- section.settings.link_label }} &rarr;
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <dl class="ag-statement__facts">
      {% for block in section.blocks %}
        <div class="ag-statement__fact" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label }}</dt>
          <dd class="ag-display">{{ block.settings.value }}</dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}
</section>

{% stylesheet %}
  .ag-statement__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }
  .ag-statement__lead {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.25;
  }
  .ag-statement__text {
    max-width: 40rem;
    margin-block: 1.75rem 2rem;
    color: var(--color-foreground-muted);
  }
  .ag-statement__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .ag-statement__fact {
    padding: 1.75rem 1.5rem 0 0;
  }
  .ag-statement__fact + .ag-statement__fact {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }
  .ag-statement__fact dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .ag-statement__fact dd {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  @media (max-width: 750px) {
    .ag-statement__grid {
      grid-template-columns: 1fr;
    }
    .ag-statement__facts {
      grid-template-columns: 1fr 1fr;
    }
    .ag-statement__fact,
    .ag-statement__fact + .ag-statement__fact {
      padding: 1.5rem 1rem 1.5rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery statement",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "About the gallery" },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Statement",
      "default": "We bring together artists who work slowly and look closely, and we help collectors live with work they truly love."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our programme moves between painting, sculpture, textile and photography. Alongside exhibitions, we offer art advisory, commissions for homes and workplaces, and framing done by hand in our own studio.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Our story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "value", "label": "Number or value", "default": "60+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Represented artists" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery statement",
      "blocks": [{ "type": "fact" }]
    }
  ]
}
{% endschema %}
