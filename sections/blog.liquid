{% comment %}
  Journal (blog) page: heading, topic filters from article tags, a
  featured latest story, then a grid of stories and page numbers.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="ag-blog full-width">
  <header class="ag-blog__head">
    <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ag-blog__title">{{ blog.title | escape }}</h1>
    {% if section.settings.intro != blank %}
      <div class="ag-blog__intro">{{ section.settings.intro }}</div>
    {% endif %}

    {% if section.settings.show_tags and blog.all_tags.size > 0 %}
      <nav class="ag-blog__tags" aria-label="{{ 'blog.topics' | t }}">
        <a href="{{ blog.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>{{ 'blog.all' | t }}</a>
        {% for tag in blog.all_tags %}
          <a
            href="{{ blog.url }}/tagged/{{ tag | handleize }}"
            {% if current_tags contains tag %}
              aria-current="page"
            {% endif %}
          >
            {{- tag -}}
          </a>
        {% endfor %}
      </nav>
    {% endif %}
  </header>

  {% paginate blog.articles by section.settings.per_page %}
    {% if blog.articles.size == 0 %}
      <div class="ag-blog__empty">
        <h2>{{ 'blog.empty_title' | t }}</h2>
        <p>{{ 'blog.empty_text' | t }}</p>
      </div>
    {% else %}
      {% liquid
        assign feature_first = false
        if section.settings.feature_latest and paginate.current_page == 1 and current_tags == blank
          assign feature_first = true
        endif
      %}

      {% if feature_first %}
        <div class="ag-blog__feature">
          {% render 'article-card', article: blog.articles.first, style: 'feature' %}
        </div>
      {% endif %}

      <ul class="ag-blog__grid" role="list">
        {% for article in blog.articles %}
          {% if feature_first and forloop.first %}{% continue %}{% endif %}
          <li>{% render 'article-card', article: article %}</li>
        {% endfor %}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .ag-blog {
    width: var(--content-width);
    margin-inline: auto;
    padding-bottom: var(--section-space);
  }
  .ag-blog__head {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }
  .ag-blog__title {
    margin-top: 1rem;
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .ag-blog__intro {
    max-width: 40rem;
    margin-top: 1.25rem;
    font-size: 1.05rem;
    color: var(--color-foreground-muted);
  }
  .ag-blog__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .ag-blog__tags a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .ag-blog__tags a:hover {
    border-color: var(--color-foreground);
  }
  .ag-blog__tags a[aria-current] {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .ag-blog__feature {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-block: 1px solid var(--color-border);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .ag-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-blog__grid:empty {
    display: none;
  }
  .ag-blog__empty {
    display: grid;
    gap: 0.75rem;
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
  }
  .ag-blog__empty h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .ag-blog__empty p {
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .ag-blog__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Journal" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Studio visits, conversations with artists, notes on collecting and stories from behind the scenes.</p>"
    },
    { "type": "checkbox", "id": "show_tags", "label": "Show topic filters", "default": true, "info": "Topics come from article tags." },
    { "type": "checkbox", "id": "feature_latest", "label": "Show latest story large", "default": true },
    { "type": "range", "id": "per_page", "min": 6, "max": 24, "step": 3, "label": "Stories per page", "default": 12 }
  ]
}
{% endschema %}
