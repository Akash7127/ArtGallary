{% comment %}
  Story: alternating image and text rows. Each block is one chapter.
{% endcomment %}

<div class="ag-story ag-section">
  {% if section.settings.heading != blank %}
    <div class="ag-section-head">
      <div>
        <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
  {% endif %}

  {% for block in section.blocks %}
    <div class="ag-story__row{% cycle '', ' ag-story__row--flip' %}" {{ block.shopify_attributes }}>
      <div class="ag-media ag-story__media">
        {% if block.settings.image %}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', alt: block.settings.heading
          }}
        {% else %}
          {% if forloop.index == 2 %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
        {% endif %}
        {% if block.settings.caption != blank %}
          <p class="ag-story__caption">{{ block.settings.caption }}</p>
        {% endif %}
      </div>
      <div class="ag-story__text">
        {% if block.settings.kicker != blank %}
          <span class="ag-story__kicker ag-display">{{ block.settings.kicker }}</span>
        {% endif %}
        <h3 class="ag-story__title">{{ block.settings.heading }}</h3>
        <div class="ag-story__body ag-rte">{{ block.settings.text }}</div>
        {% if block.settings.link_label != blank %}
          <a class="ag-link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label }} &rarr;</a>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% stylesheet %}
  .ag-story__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .ag-story__row + .ag-story__row {
    margin-top: clamp(3.5rem, 8vw, 6.5rem);
  }
  .ag-story__row--flip .ag-story__media {
    order: 2;
  }
  .ag-story__media {
    aspect-ratio: 4 / 5;
  }
  .ag-story__row--flip .ag-story__media {
    aspect-ratio: 5 / 4;
  }
  .ag-story__caption {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-background);
    font-size: 0.8rem;
  }
  .ag-story__kicker {
    display: block;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1;
    color: var(--color-accent);
  }
  .ag-story__title {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  .ag-story__body {
    max-width: 34rem;
    margin-block: 1.25rem 1.75rem;
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-story__row {
      grid-template-columns: 1fr;
    }
    .ag-story__row--flip .ag-story__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Image caption" },
        { "type": "text", "id": "kicker", "label": "Large number or word", "info": "For example a year." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Chapter heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell this part of your story.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story",
      "blocks": [{ "type": "chapter" }, { "type": "chapter" }]
    }
  ]
}
{% endschema %}
