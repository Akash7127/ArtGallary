{% comment %}
  Timeline of milestones. Each block is one moment (year, title, text).
{% endcomment %}

<div class="ag-timeline ag-section ag-section--surface full-width">
  <div class="ag-timeline__inner">
    <div class="ag-timeline__head">
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <ol class="ag-timeline__list" role="list">
      {% for block in section.blocks %}
        <li class="ag-timeline__item" {{ block.shopify_attributes }}>
          <span class="ag-timeline__year ag-display">{{ block.settings.year }}</span>
          <div>
            <h3 class="ag-timeline__title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p class="ag-timeline__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</div>

{% stylesheet %}
  .ag-timeline__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 6vw, 6rem);
    width: var(--content-width);
    margin-inline: auto;
  }
  .ag-timeline__head {
    position: sticky;
    top: 7rem;
    align-self: start;
  }
  .ag-timeline__head h2 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }
  .ag-timeline__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-timeline__list::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.35rem;
    width: 1px;
    background: var(--color-border);
  }
  .ag-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0 0 2.5rem 2rem;
  }
  .ag-timeline__item:last-child {
    padding-bottom: 0;
  }
  .ag-timeline__item::before {
    content: '';
    position: absolute;
    top: 0.7rem;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-surface);
  }
  .ag-timeline__year {
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--color-accent);
  }
  .ag-timeline__title {
    font-size: 1.4rem;
  }
  .ag-timeline__text {
    margin-top: 0.5rem;
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-timeline__inner {
      grid-template-columns: 1fr;
    }
    .ag-timeline__head {
      position: static;
    }
  }
  @media (max-width: 600px) {
    .ag-timeline__item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Milestones" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Along the way" }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "title", "label": "Title", "default": "Milestone" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline",
      "blocks": [{ "type": "moment" }, { "type": "moment" }, { "type": "moment" }]
    }
  ]
}
{% endschema %}
