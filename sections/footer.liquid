<footer class="ag-footer full-width">
  <div class="ag-footer__inner">
    <div class="ag-footer__brand">
      <a class="ag-footer__name ag-display" href="{{ routes.root_url }}">{{ shop.name }}</a>
      {% if section.settings.about != blank %}
        <div class="ag-footer__about">{{ section.settings.about }}</div>
      {% endif %}
    </div>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="ag-footer__col" aria-label="{{ section.settings.menu.title }}">
        <h2 class="ag-footer__title">{{ section.settings.menu.title }}</h2>
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    <div class="ag-footer__col">
      <h2 class="ag-footer__title">{{ section.settings.visit_title }}</h2>
      {% if section.settings.address != blank %}
        <div class="ag-footer__address">{{ section.settings.address }}</div>
      {% endif %}
      {% if section.settings.hours != blank %}
        <p>{{ section.settings.hours }}</p>
      {% endif %}
    </div>

    <div class="ag-footer__col">
      <h2 class="ag-footer__title">{{ 'footer.contact' | t }}</h2>
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      {% endif %}
      {% if section.settings.phone != blank %}
        <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
      {% endif %}
      {% if section.settings.instagram != blank %}
        <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>
      {% endif %}
    </div>
  </div>

  <div class="ag-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {% if section.settings.show_payment_icons %}
      <div class="ag-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .ag-footer {
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.92rem;
  }
  .ag-footer a {
    color: inherit;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .ag-footer a:hover {
    opacity: 1;
  }
  .ag-footer__inner,
  .ag-footer__bottom {
    width: var(--content-width);
    margin-inline: auto;
  }
  .ag-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }
  .ag-footer .ag-footer__name {
    font-size: 2rem;
    opacity: 1;
  }
  .ag-footer__about {
    max-width: 22rem;
    margin-top: 1rem;
    opacity: 0.7;
  }
  .ag-footer__col {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.6rem;
  }
  .ag-footer__col p,
  .ag-footer__address {
    opacity: 0.75;
  }
  .ag-footer__title {
    margin-bottom: 0.5rem;
    font-family: var(--font-primary--family);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-accent) 55%, white);
  }
  .ag-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.8rem;
    opacity: 0.8;
  }
  .ag-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ag-footer__payment svg {
    width: 2.4rem;
  }
  @media (max-width: 900px) {
    .ag-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .ag-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 500px) {
    .ag-footer__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "About text",
      "default": "<p>A contemporary art gallery showing painting, sculpture and works on paper.</p>"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "footer"
    },
    { "type": "text", "id": "visit_title", "label": "Visit heading", "default": "Visit" },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>Gallery address<br>City, State</p>"
    },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Tue – Sun, 11am – 7pm" },
    { "type": "text", "id": "email", "label": "Email" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
