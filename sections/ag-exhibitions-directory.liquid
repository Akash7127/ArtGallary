{% comment %}
  Exhibitions page. Reads "exhibition" metaobjects and sorts them by date
  into Now showing, Coming soon and Past (grouped by year).
{% endcomment %}

{% liquid
  assign exhibitions = shop.metaobjects.exhibition.values
  assign today = 'now' | date: '%Y-%m-%d'

  assign current_keys = ''
  assign upcoming_keys = ''
  assign past_keys = ''
  for ex in exhibitions
    assign start = ex.start_date.value | date: '%Y-%m-%d'
    assign end = ex.end_date.value | date: '%Y-%m-%d'
    if start == blank
      assign start = '0000-00-00'
    endif
    assign key = start | append: '::' | append: forloop.index0 | append: '||'
    if start > today
      assign upcoming_keys = upcoming_keys | append: key
    elsif end != blank and end < today
      assign past_keys = past_keys | append: key
    else
      assign current_keys = current_keys | append: key
    endif
  endfor

  assign current_keys = current_keys | split: '||' | sort
  assign upcoming_keys = upcoming_keys | split: '||' | sort
  assign past_keys = past_keys | split: '||' | sort | reverse
%}

<div class="ag-exdir full-width">
  <header class="ag-exdir__head">
    <div>
      <span class="ag-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="ag-exdir__title">{{ section.settings.heading | default: page.title }}</h1>
      {% if section.settings.intro != blank %}
        <div class="ag-exdir__intro">{{ section.settings.intro }}</div>
      {% elsif page.content != blank %}
        <div class="ag-exdir__intro ag-rte">{{ page.content }}</div>
      {% endif %}
    </div>

    {% if exhibitions.size > 0 %}
      <nav class="ag-exdir__jump" aria-label="{{ 'exhibitions.jump_to' | t }}">
        {% if current_keys.size > 0 %}
          <a href="#Current-{{ section.id }}">{{ 'exhibitions.current' | t }} <span>{{ current_keys.size }}</span></a>
        {% endif %}
        {% if upcoming_keys.size > 0 %}
          <a href="#Upcoming-{{ section.id }}">{{ 'exhibitions.upcoming' | t }} <span>{{ upcoming_keys.size }}</span></a>
        {% endif %}
        {% if past_keys.size > 0 and section.settings.show_past %}
          <a href="#Past-{{ section.id }}">{{ 'exhibitions.past' | t }} <span>{{ past_keys.size }}</span></a>
        {% endif %}
      </nav>
    {% endif %}
  </header>

  {% if exhibitions.size == 0 %}
    {% if request.design_mode %}
      <section class="ag-exdir__group">
        <div class="ag-exdir__feature">{% render 'exhibition-card', style: 'feature', index: 1 %}</div>
        <ul class="ag-exdir__grid" role="list">
          {% for i in (2..4) %}
            <li>{% render 'exhibition-card', index: i %}</li>
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <p class="ag-exdir__empty">{{ 'exhibitions.none' | t }}</p>
    {% endif %}
  {% endif %}

  {% if current_keys.size > 0 %}
    <section class="ag-exdir__group" id="Current-{{ section.id }}" aria-labelledby="CurrentHeading-{{ section.id }}">
      <h2 class="ag-exdir__group-title" id="CurrentHeading-{{ section.id }}">{{ 'exhibitions.current' | t }}</h2>
      {% liquid
        assign i = current_keys.first | split: '::' | last | plus: 0
        assign ex = exhibitions[i]
      %}
      <div class="ag-exdir__feature">{% render 'exhibition-card', exhibition: ex, style: 'feature' %}</div>
      {% if current_keys.size > 1 %}
        <ul class="ag-exdir__grid" role="list">
          {% for key in current_keys offset: 1 %}
            {% assign i = key | split: '::' | last | plus: 0 %}
            <li>{% render 'exhibition-card', exhibition: exhibitions[i], index: forloop.index %}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endif %}

  {% if upcoming_keys.size > 0 %}
    <section class="ag-exdir__group" id="Upcoming-{{ section.id }}" aria-labelledby="UpcomingHeading-{{ section.id }}">
      <h2 class="ag-exdir__group-title" id="UpcomingHeading-{{ section.id }}">{{ 'exhibitions.upcoming' | t }}</h2>
      <ul class="ag-exdir__grid" role="list">
        {% for key in upcoming_keys %}
          {% assign i = key | split: '::' | last | plus: 0 %}
          <li>{% render 'exhibition-card', exhibition: exhibitions[i], index: forloop.index %}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if section.settings.show_past and past_keys.size > 0 %}
    <section class="ag-exdir__group" id="Past-{{ section.id }}" aria-labelledby="PastHeading-{{ section.id }}">
      <h2 class="ag-exdir__group-title" id="PastHeading-{{ section.id }}">{{ 'exhibitions.past' | t }}</h2>
      {% assign last_year = '' %}
      {% for key in past_keys limit: section.settings.past_limit %}
        {% liquid
          assign i = key | split: '::' | last | plus: 0
          assign ex = exhibitions[i]
          assign year = key | slice: 0, 4
        %}
        {% if year != last_year and year != '0000' %}
          <h3 class="ag-exdir__year ag-display">{{ year }}</h3>
          {% assign last_year = year %}
        {% endif %}
        {% render 'exhibition-card', exhibition: ex, style: 'row' %}
      {% endfor %}
    </section>
  {% endif %}
</div>

{% stylesheet %}
  .ag-exdir {
    width: var(--content-width);
    margin-inline: auto;
    padding-bottom: var(--section-space);
  }
  .ag-exdir__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }
  .ag-exdir__head > div {
    max-width: 46rem;
  }
  .ag-exdir__title {
    margin-top: 1rem;
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .ag-exdir__intro {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    color: var(--color-foreground-muted);
  }
  .ag-exdir__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ag-exdir__jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .ag-exdir__jump a:hover {
    border-color: var(--color-foreground);
  }
  .ag-exdir__jump span {
    color: var(--color-foreground-muted);
  }
  .ag-exdir__group {
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }
  .ag-exdir__group + .ag-exdir__group {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .ag-exdir__group-title {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .ag-exdir__feature + .ag-exdir__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .ag-exdir__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-exdir__year {
    margin-top: 2rem;
    font-size: 1.5rem;
    color: var(--color-accent);
  }
  .ag-exdir__year:first-of-type {
    margin-top: 0;
  }
  .ag-exdir__empty {
    padding-block: 3rem;
    color: var(--color-foreground-muted);
  }
  @media (max-width: 900px) {
    .ag-exdir__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .ag-exdir__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Exhibitions directory",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Programme" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exhibitions" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "info": "Leave empty to use the page content instead.",
      "default": "<p>What's on in the gallery and online, what's coming next, and everything we've shown before.</p>"
    },
    { "type": "checkbox", "id": "show_past", "label": "Show past exhibitions", "default": true },
    { "type": "range", "id": "past_limit", "min": 6, "max": 48, "step": 6, "label": "Past exhibitions to show", "default": 24 }
  ],
  "presets": [{ "name": "Exhibitions directory" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
