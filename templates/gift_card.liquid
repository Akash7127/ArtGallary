{% layout none %}

{% comment %}
  Gift card page: the link in the gift card email opens this page.
  Shows the card, balance, code (with copy), QR code for in-person use,
  Apple Wallet, print and shop buttons.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/gift-card-liquid
{% endcomment %}

{% liquid
  assign is_inactive = false
  if gift_card.enabled == false or gift_card.expired
    assign is_inactive = true
  endif
  assign used = false
  if gift_card.balance < gift_card.initial_value
    assign used = true
  endif
%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    <meta name="robots" content="noindex">
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>

    {% style %}
      .ag-gift {
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: clamp(1.5rem, 5vw, 4rem) 1rem;
      }
      .ag-gift__inner {
        display: grid;
        gap: 2rem;
        width: min(100%, 34rem);
      }
      .ag-gift__brand {
        font-size: 1.5rem;
        text-align: center;
        text-decoration: none;
        color: inherit;
      }
      .ag-gift__card {
        position: relative;
        aspect-ratio: 1.586;
        overflow: hidden;
        padding: clamp(1.25rem, 5vw, 2rem);
        border-radius: 1rem;
        background:
          radial-gradient(circle at 85% 15%, color-mix(in srgb, var(--color-accent) 70%, transparent) 0 18%, transparent 19%),
          radial-gradient(circle at 70% 85%, rgb(255 255 255 / 0.08) 0 30%, transparent 31%),
          linear-gradient(135deg, #2a231d, var(--color-foreground));
        color: #f7f4ef;
        box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .ag-gift__card-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        opacity: 0.85;
      }
      .ag-gift__card-name {
        font-family: var(--font-heading--family);
        font-size: clamp(1.25rem, 4vw, 1.6rem);
        letter-spacing: 0;
        text-transform: none;
        opacity: 1;
      }
      .ag-gift__balance {
        font-family: var(--font-heading--family);
        font-size: clamp(2.5rem, 10vw, 3.75rem);
        line-height: 1;
      }
      .ag-gift__initial {
        margin-top: 0.4rem;
        font-size: 0.85rem;
        opacity: 0.75;
      }
      .ag-gift__card.is-inactive {
        filter: grayscale(1);
        opacity: 0.6;
      }
      .ag-gift__notice {
        padding: 0.9rem 1.1rem;
        border-left: 2px solid var(--color-accent);
        background: var(--color-surface);
      }
      .ag-gift__panel {
        display: grid;
        gap: 1.25rem;
        padding: clamp(1.25rem, 4vw, 1.75rem);
        background: var(--color-surface);
      }
      .ag-gift__label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-foreground-muted);
      }
      .ag-gift__code-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
      }
      .ag-gift__code {
        flex: 1;
        min-width: 12rem;
        padding: 0.85rem 1rem;
        border: 1px dashed var(--color-foreground);
        background: var(--color-background);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 1.15rem;
        letter-spacing: 0.08em;
        text-align: center;
      }
      .ag-gift__how {
        font-size: 0.92rem;
        color: var(--color-foreground-muted);
      }
      .ag-gift__qr-wrap {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .ag-gift__qr {
        flex: none;
        padding: 0.5rem;
        background: #fff;
      }
      .ag-gift__qr img,
      .ag-gift__qr canvas {
        width: 6.5rem;
        height: 6.5rem;
      }
      .ag-gift__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }
      .ag-gift__wallet img {
        height: 2.75rem;
        width: auto;
      }
      .ag-gift__expiry {
        font-size: 0.85rem;
        text-align: center;
        color: var(--color-foreground-muted);
      }
      @media print {
        body {
          background: #fff;
        }
        .ag-gift__actions,
        .ag-gift__copy {
          display: none !important;
        }
        .ag-gift__card {
          box-shadow: none;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="ag-gift">
      <div class="ag-gift__inner">
        <a class="ag-gift__brand ag-display" href="{{ routes.root_url }}">{{ shop.name }}</a>

        <div class="ag-gift__card{% if is_inactive %} is-inactive{% endif %}" role="img" aria-label="{{ 'gift_card.card' | t }}">
          <div class="ag-gift__card-top">
            <span class="ag-gift__card-name">{{ shop.name }}</span>
            <span>{{ 'gift_card.card' | t }}</span>
          </div>
          <div>
            <p class="ag-gift__balance">{{ gift_card.balance | money }}</p>
            {% if used %}
              {%- assign initial = gift_card.initial_value | money -%}
              <p class="ag-gift__initial">{{ 'gift_card.initial_value' | t: value: initial }}</p>
            {% endif %}
          </div>
        </div>

        {% if is_inactive %}
          <p class="ag-gift__notice" role="status">{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        <h1 class="visually-hidden">{{ 'gift_card.title' | t: shop: shop.name }}</h1>

        <div class="ag-gift__panel">
          <div>
            <p class="ag-gift__label">{{ 'gift_card.code_label' | t }}</p>
            <div class="ag-gift__code-row">
              <span class="ag-gift__code" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
              <button
                type="button"
                class="ag-btn ag-btn--outline ag-gift__copy"
                data-copy="{{ gift_card.code }}"
                data-copied="{{ 'gift_card.copied' | t }}"
              >
                {{- 'gift_card.copy' | t -}}
              </button>
            </div>
          </div>
          <p class="ag-gift__how">{{ 'gift_card.use_at_checkout' | t }}</p>

          <div class="ag-gift__qr-wrap">
            <div class="ag-gift__qr" id="GiftCardQr" data-identifier="{{ gift_card.qr_identifier }}"></div>
            <p class="ag-gift__how">{{ 'gift_card.qr_text' | t }}</p>
          </div>
        </div>

        <div class="ag-gift__actions">
          <a class="ag-btn" href="{{ routes.all_products_collection_url }}">{{ 'gift_card.shop' | t }}</a>
          <button type="button" class="ag-btn ag-btn--outline" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
          {% if gift_card.pass_url %}
            <a class="ag-gift__wallet" href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
                width="120"
                height="40"
                loading="lazy"
              >
            </a>
          {% endif %}
        </div>

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%-d %B %Y' %}
          <p class="ag-gift__expiry">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {% endif %}
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qr = document.getElementById('GiftCardQr');
        if (qr && window.QRCode) {
          new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, correctLevel: QRCode.CorrectLevel.M });
        } else if (qr) {
          qr.parentElement.hidden = true;
        }
        var copy = document.querySelector('[data-copy]');
        if (copy && navigator.clipboard) {
          copy.addEventListener('click', function () {
            navigator.clipboard.writeText(copy.dataset.copy).then(function () {
              var text = copy.textContent;
              copy.textContent = copy.dataset.copied;
              setTimeout(function () { copy.textContent = text; }, 2000);
            });
          });
        } else if (copy) {
          copy.hidden = true;
        }
      });
    </script>
  </body>
</html>
